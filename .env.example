# Copy to .env.local for local development. All values below are dummies.
# Every key here is consumed by backend, scripts, or frontend config.

# Backend runtime (src/quote/repo/database.py, src/quote/service/security.py, src/quote/api/main.py)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
CORS_ORIGINS=http://localhost:5173
FRONTEND_DIST=frontend/dist

# Privileged scripts only. Never commit real values.
# (src/quote/service/supabase_admin.py, scripts/bootstrap_admin.py, scripts/migrate_legacy_users.py)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
SUPABASE_BOOTSTRAP_EMAIL=admin@example.com
SUPABASE_BOOTSTRAP_PASSWORD=REPLACE_WITH_BOOTSTRAP_PASSWORD
LEGACY_DATABASE_URL=postgresql://LEGACY_USER:URL_ENCODED_PASSWORD@legacy-host:5432/legacy_db

# Frontend build-time configuration. These values are publishable.
# (frontend/src/config/supabase.ts, frontend/src/config/api.ts)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
VITE_API_URL=http://localhost:5001/api
