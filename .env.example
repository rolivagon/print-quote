# Backend runtime and read-only Supabase verification.
# Use a PostgreSQL connection string with a read-only database role when testing production.
DATABASE_URL=postgresql://READ_ONLY_USER:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Browser origin allowed by the FastAPI backend.
CORS_ORIGINS=https://app.example.com

# Required only for backend-side invitations, bootstrap, and legacy-user migration.
# Never expose this value to the frontend or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
SUPABASE_BOOTSTRAP_EMAIL=admin@example.com
LEGACY_DATABASE_URL=postgresql://LEGACY_READ_ONLY_USER:URL_ENCODED_PASSWORD@legacy-host:5432/legacy_db

# Frontend build-time configuration. These values are publishable.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
VITE_API_URL=https://api.example.com/api
